# =============================================================================
# Brewfile – Homebrew Bundle
#
# Install everything:  brew bundle
# Check what's missing: brew bundle check
# Cleanup unlisted:    brew bundle cleanup --force
# =============================================================================

# ── Taps ────────────────────────────────────────────────────────────────────
tap "homebrew/bundle"
tap "homebrew/services"

# ── CLI essentials ──────────────────────────────────────────────────────────
brew "git"                    # Version control
brew "git-lfs"                # Git Large File Storage
brew "gh"                     # GitHub CLI
brew "curl"                   # HTTP client
brew "wget"                   # HTTP/FTP downloader
brew "jq"                     # JSON processor
brew "yq"                     # YAML/JSON/XML processor
brew "ripgrep"                # Fast grep (rg)
brew "fd"                     # Fast find
brew "bat"                    # cat with syntax highlighting
brew "eza"                    # Modern ls replacement
brew "fzf"                    # Fuzzy finder
brew "zoxide"                 # Smarter cd
brew "tldr"                   # Simplified man pages
brew "tree"                   # Directory tree view
brew "htop"                   # Interactive process viewer
brew "ncdu"                   # Disk usage analyser
brew "tmux"                   # Terminal multiplexer
brew "zsh-autosuggestions"    # Fish-style autosuggestions for zsh
brew "zsh-syntax-highlighting" # Syntax highlighting for zsh
brew "starship"               # Cross-shell prompt

# ── Languages & runtimes ────────────────────────────────────────────────────
brew "node"                   # Node.js (latest stable)
brew "nvm"                    # Node version manager
brew "python"                 # Python 3
brew "pyenv"                  # Python version manager
brew "go"                     # Go language
brew "rustup"                 # Rust toolchain installer
brew "ruby"                   # Ruby

# ── Package / project managers ──────────────────────────────────────────────
brew "pnpm"                   # Fast Node package manager
brew "yarn"                   # Node package manager

# ── Containers & cloud ──────────────────────────────────────────────────────
brew "docker-compose"         # Docker Compose (standalone CLI)
brew "kubectl"                # Kubernetes CLI
brew "helm"                   # Kubernetes package manager
brew "awscli"                 # AWS CLI

# ── Database tools ──────────────────────────────────────────────────────────
brew "postgresql@16"          # PostgreSQL
brew "redis"                  # Redis

# ── Security & networking ────────────────────────────────────────────────────
brew "gnupg"                  # GPG encryption
brew "openssh"                # OpenSSH
brew "mkcert"                 # Local HTTPS certificates

# ── macOS utilities ─────────────────────────────────────────────────────────
brew "mas"                    # Mac App Store CLI
brew "mackup"                 # App settings backup/restore

# ── GUI apps (casks) ────────────────────────────────────────────────────────
cask "visual-studio-code"     # Code editor
cask "iterm2"                 # Terminal emulator
cask "docker"                 # Docker Desktop
cask "rectangle"              # Window manager
cask "raycast"                # Spotlight replacement
cask "1password"              # Password manager
cask "arc"                    # Browser
cask "tableplus"              # Database GUI
cask "insomnia"               # REST/GraphQL client
cask "fig"                    # Terminal autocomplete (now Amazon Q)
cask "font-fira-code-nerd-font" # Programming font with icons
cask "font-jetbrains-mono-nerd-font" # JetBrains Mono with icons

# ── Mac App Store apps ──────────────────────────────────────────────────────
